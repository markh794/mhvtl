# AppArmor profile for the mhVTL tape daemon.
#
# Shipped in complain (learning) mode: AppArmor logs accesses that fall
# outside the profile but never denies them, so enabling it cannot break a
# working deployment. Review the logged events (dmesg / audit) and, once the
# profile covers your configuration, drop `flags=(complain)` to enforce it.
abi <abi/3.0>,

include <tunables/global>

profile mhvtl-vtltape /usr/libexec/mhvtl/vtltape flags=(complain) {
  include <abstractions/base>
  include <abstractions/nameservice>

  # The daemon creates its own /dev/mhvtl<n> character node and raises its
  # resource limits; it overrides DAC on the media it owns.
  capability mknod,
  capability sys_resource,
  capability dac_override,

  network unix stream,

  # Executable and the private, RUNPATH-resolved library.
  /usr/libexec/mhvtl/vtltape         mr,
  /usr/lib/mhvtl/libvtlscsi.so*      mr,
  /usr/lib64/mhvtl/libvtlscsi.so*    mr,
  /usr/lib/@{multiarch}/mhvtl/libvtlscsi.so* mr,

  # The CLIs it may exec (vtlcmd is used for control messages).
  /usr/bin/vtlcmd                    rix,

  # Configuration (read-only).
  /etc/mhvtl/                        r,
  /etc/mhvtl/**                      r,

  # Virtual media and the per-drive FIFO live under the home directory.
  /var/lib/mhvtl/                    rw,
  /var/lib/mhvtl/**                  rwk,

  # Runtime socket and lock directories (and their historical spellings).
  owner /run/mhvtl/**                rw,
  owner /run/lock/mhvtl/**           rwk,
  owner /var/run/mhvtl/**            rw,
  owner /var/lock/mhvtl/**           rwk,

  # The emulated SCSI character device backed by mhvtl.ko.
  /dev/mhvtl[0-9]*                   rw,

  /{,var/}run/systemd/notify         w,
}
