[Unit]
Documentation=man:vtllibrary(1) man:vtlcmd(1)
Description=Robot Library Daemon for Virtual Tape & Robot Library
Before=mhvtl.target
Requires=mhvtl-load-modules.service
# With MHVTL_BACKEND=tcmu the handler serves the device; it exits at once
# otherwise, and systemd skips it when mhvtl-tcmu is not installed.
Wants=mhvtl-tcmu-handler.service
# Wants rather than Requires: a library whose media could not be created still
# starts (with those slots empty), as it did before media creation moved here.
Wants=mhvtl-media.service
After=mhvtl-load-modules.service mhvtl-tcmu-handler.service mhvtl-media.service
PartOf=mhvtl.target

[Service]
Type=simple
Environment=VERBOSE=0
Environment=DAEMON_DEBUG=
EnvironmentFile=-@CONF_PATH@/mhvtl.conf
ExecStart=@LIBEXEC_PATH@/vtllibrary -F -q%i -v${VERBOSE} ${DAEMON_DEBUG}
ExecStop=/usr/bin/vtlcmd %i exit
KillMode=mixed
TimeoutStopSec=10
# With MHVTL_BACKEND=tcmu the daemon exits with 75 (EX_TEMPFAIL) when the
# handler goes away without a stop or restart job, e.g. it crashed. Restart it
# then, so it registers with the next handler (Wants= above starts one); it
# waits up to 30 s for it. Other exits are not restarted, as before. A stop or
# restart of the handler reaches the daemon through the PartOf= drop-in that
# mhvtl-device-conf-generator writes for the TCMU backend.
RestartForceExitStatus=75
RestartSec=1
# No lock-file cleanup is needed: the lock is a held flock() the kernel releases
# when the daemon exits (including on a crash), so a leftover file never blocks
# a restart.
ExecReload=/usr/bin/kill -HUP $MAINPID

# The daemon runs as root because it creates its own /dev/mhvtl<n> node and the
# module exports no uevent for udev to act on. Everything root is not needed
# for is dropped. PrivateDevices must stay off - it would hide that node.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_MKNOD CAP_SYS_RESOURCE CAP_DAC_OVERRIDE
ProtectSystem=yes
ProtectHome=yes
ProtectKernelModules=yes
# ProtectKernelTunables must stay off: it remounts /sys read-only, and the
# daemon registers its logical unit by writing the queue id to
# /sys/bus/mhvtl/drivers/mhvtl/add_lu. With /sys read-only that write fails
# with EROFS, no SCSI device is ever created, and the library comes up empty.
ProtectKernelTunables=no
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=mhvtl.target
