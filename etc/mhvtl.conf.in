#
# mhvtl.conf
#

# Home directory for tape emulation files
MHVTL_HOME_PATH=@HOME_PATH@

# Default media capacity (500 M)
CAPACITY=500

# Set default verbosity [0|1|2|3]
VERBOSE=1

# Set kernel module debugging [0|1]
VTL_DEBUG=0

# vtltape and vtllibrary debugging [Blank or -d]
#DAEMON_DEBUG=-d

# Backend that delivers SCSI commands to the daemons [mhvtl|tcmu]
# mhvtl: the mhvtl.ko kernel module; tcmu: LIO user backstores served by
# mhvtl_tcmu_handler, which mhvtl-fabrics can export over iSCSI.
#MHVTL_BACKEND=mhvtl

# With tcmu, also present the devices on this host through tcm_loop [yes|no]
# A host that only exports them to remote initiators can set no.
#MHVTL_TCMU_LOOPBACK=yes
